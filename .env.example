# Publishable: embedded in the public widget; never use a provider/server key here.
ROUTER_PUBLIC_APP_KEY=router_public_REPLACE_WITH_RANDOM_VALUE
# Server only, independent random 32-byte base64url credential.
ROUTER_SERVER_KEY=REPLACE_WITH_RANDOM_SERVER_CREDENTIAL
ROUTER_PUBLIC_ORIGIN=https://your-router.vercel.app
# Optional exact HTTPS frontend origins (maximum 16; no wildcards or paths).
ROUTER_ALLOWED_ORIGINS_JSON=[]
# Durable Redis database. Disable eviction. Do not share with caches or previews.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_SERVER_ONLY_REDIS_TOKEN
ROUTER_REDIS_NAMESPACE=instinct-router-production-v1
# Optional provider credentials, server only.
RELAY_API_KEY=
AURORA_API_KEY=
# Optional JSON with operator-configured HTTPS RPC endpoints.
ROUTER_EXECUTION_RPC_JSON=
ROUTER_PROVIDER_EXECUTION_RPC_JSON=
